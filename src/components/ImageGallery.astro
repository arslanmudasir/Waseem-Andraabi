---
const images = await Astro.glob("/public/image_gallery/*.webp");
---

<section class="px-5 sm:px-10 flex justify-center mt-10">
  <div class="carousel carousel-center bg-primary_light w-4/5 sm:w-3/4 md:w-4/5 rounded-box p-2 sm:p-4">
    {
      images.map((image) => (
        <div class="carousel-item h-96 w-fit flex-shrink-0 px-1 py-3">
          <img src={image.default.src} class="object-cover rounded-lg w-full h-full" alt="Gallery image" />
        </div>
      ))
    }
  </div>
</section>
